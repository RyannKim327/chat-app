{
  "name": "backend",
  "version": "1.0.0",
  "description": "Us-APP API — Fastify + JSON file store",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "start:once": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "node -e \"require('node:fs').rmSync('db/us-app.json',{force:true});console.log('database reset, it will reseed on next boot')\""
  },
